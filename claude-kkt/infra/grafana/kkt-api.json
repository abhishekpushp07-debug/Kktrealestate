          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(http_requests_total{job=\"kkt-api\",status=~\"5..\",status!=\"503\"}[5m])) / sum(rate(http_requests_total{job=\"kkt-api\"}[5m]))",
          "refId": "A"
