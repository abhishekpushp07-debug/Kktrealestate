# Every secret below may instead be given as <NAME>_FILE=/run/secrets/<file> (Docker/K8s secrets): JWT_SECRET, FIELD_ENCRYPTION_KEY,
# FIELD_ENCRYPTION_KEYS, HASH_KEY, DATABASE_URL, DATABASE_REPLICA_URL, REDIS_URL, REDIS_SECURITY_URL, S3_ACCESS_KEY, S3_SECRET_KEY,
# METRICS_TOKEN, BOOTSTRAP_ADMIN_PASSWORD, ERROR_WEBHOOK_URL, JWT_SIGNING_KEYS, LINK_SIGNING_KEYS, HASH_KEYS, INTERNAL_API_TOKEN,
# WEB_REVALIDATE_TOKEN. Setting both NAME and NAME_FILE is an error.
# ---- Database / cache ----
# Required in production (no localhost defaults there)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kkt
# Optional read replica for reports and public reads
DATABASE_REPLICA_URL=
# Per-connection limits (0 = none): statement, lock wait, idle-in-transaction (ms); TCP connect timeout (s)
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TX_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_S=10
# Required in production
REDIS_URL=redis://localhost:6379/0
# Optional separate noeviction Redis for revocation markers, locks and rate limits (falls back to REDIS_URL)
REDIS_SECURITY_URL=
# Upper bound of one Redis command (ms, 100-60000); cache/auth reads fall back to Postgres much sooner (150-250 ms)
REDIS_COMMAND_TIMEOUT_MS=2000
# ---- API ----
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
NODE_ENV=development
# 32+ random bytes, base64. Rotate by adding a new key id (see docs/SECURITY.md)
JWT_SECRET=change-me-use-openssl-rand-base64-48
# 32 bytes base64 for AES-256-GCM field encryption; keyed hashes use HMAC-SHA256 with HASH_KEY
FIELD_ENCRYPTION_KEY=change-me-32-bytes-base64
# Optional key ring for rotation: kid:base64key,kid:base64key (first = active). FIELD_ENCRYPTION_KEY is always key id k1.
FIELD_ENCRYPTION_KEYS=
# Optional comma list of previous JWT secrets, accepted for verification only during a rotation window
JWT_PREVIOUS_SECRETS=
HASH_KEY=change-me-hash-key
# Key rings (contract C9): `<kid>:<value>` comma lists, first = active, older entries verify / look up only. Required in production
# (placeholders are refused at boot); outside production they are derived from JWT_SECRET / HASH_KEY when empty. Generate:
#   JWT_SIGNING_KEYS  node -e "const k=require('crypto').generateKeyPairSync('ed25519').privateKey;console.log('j1:'+k.export({type:'pkcs8',format:'der'}).toString('base64'))"
#                     (or: echo "j1:$(openssl genpkey -algorithm ed25519 -outform DER | base64 | tr -d '\n')")
#   LINK_SIGNING_KEYS echo "l1:$(openssl rand -hex 32)"
#   HASH_KEYS         echo "h1:$HASH_KEY"   (h1 must equal HASH_KEY; add h2:<new> in front to rotate, then run REENCRYPT_FIELDS)
# Rotation: docs/DEPLOY.md "Secrets and key rotation".
JWT_SIGNING_KEYS=
LINK_SIGNING_KEYS=
HASH_KEYS=
# Absolute lifetime of a refresh-token family in days (rotation never extends it; contract C1)
REFRESH_ABSOLUTE_TTL_DAYS=30
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Comma separated browser origins per surface
ERP_ORIGIN=http://localhost:5173
WEB_ORIGIN=http://localhost:3000
PORTAL_ORIGIN=http://localhost:8081
# Storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# STORAGE_DRIVER=s3 requires S3_BUCKET and S3_REGION; leave both keys empty to use an IAM role (keys come in pairs)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# A database without a company is ALWAYS bootstrapped at boot (production: from BOOTSTRAP_*, refusing to start without them).
# SEED_ON_BOOT re-runs the idempotent bootstrap and, together with SEED_DEMO, creates the demo dataset. Defaults: true outside
# production, false in production (docs/DEPLOY.md "First boot")
SEED_ON_BOOT=true
# The demo dataset (Shree Ganesh Builders) is created at boot only when SEED_ON_BOOT and SEED_DEMO are both true
SEED_DEMO=true
# First production boot: the company and the one Super Admin (instead of demo users). Email + password together, password >= 12 chars
# with an upper-case letter, a lower-case letter and a digit. Ignored once a company exists
BOOTSTRAP_COMPANY_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# OpenAPI document + Swagger UI for anyone (/api/v1/openapi.json, /api/v1/docs). Default: true outside production, false in production
# (then only a staff token with admin.tools may read them)
DOCS_PUBLIC=
# Identity of this rollout (keys the once-per-deploy boot jobs); falls back to GIT_SHA, then to the worker's start time
DEPLOY_ID=
GIT_SHA=
# ---- API runtime / performance (docs/PERFORMANCE.md) ----
# HTTP worker processes: 1 (dev/test) or `auto` = one per CPU; migrations + seed run once in the primary. Default: 1, production: auto.
API_WORKERS=1
# Postgres pool size per worker process (keep workers × pool below PgBouncer/Postgres max_connections)
DATABASE_POOL_MAX=20
# Named prepared statements for every query (plans cached per connection). Set false behind PgBouncer < 1.21 in transaction mode.
DATABASE_PREPARE=true
# Requests in flight per worker before the excess gets 503 + Retry-After (0 = off). Default 0, production: 256.
API_MAX_INFLIGHT=0
# Event-loop pressure: above this mean event-loop delay (ms, per 500 ms window) the in-flight cap drops to a quarter (never below 8)
# until the delay is under half of it again (0 = off). /health, /ready and /metrics are never shed.
API_SHED_EVENT_LOOP_DELAY_MS=500
# Run BullMQ jobs inside the API (first worker) instead of a separate `pnpm --filter @kkt/api worker` process. Default: true, production: false
RUN_JOBS_IN_API=true
# Rate limits: public reads per IP per minute; staff/portal writes per user per minute (raise both for load tests)
PUBLIC_RATE_LIMIT_PER_MIN=300
WRITE_RATE_LIMIT_PER_MIN=120
# Per route group per minute for the website server's own calls (valid INTERNAL_API_TOKEN, no visitor IP: ISR regenerations, contract C3)
INTERNAL_RATE_LIMIT_PER_MIN=6000
LOG_LEVEL=info
# Peers allowed to set X-Forwarded-For: false | true | comma list of loopback, linklocal, uniquelocal, IPs, CIDRs (10.0.0.0/8)
TRUST_PROXY=loopback
# Shared secret (>= 32 chars) for internal callers such as the website SSR; off when empty
INTERNAL_API_TOKEN=
# The website's on-demand revalidation route and its shared secret (>= 32 chars, = the website's WEB_REVALIDATE_TOKEN); off when empty
WEB_REVALIDATE_URL=
WEB_REVALIDATE_TOKEN=
# libuv threads shared by argon2, sharp, zlib and fs (Node's default is 4)
UV_THREADPOOL_SIZE=16
# ---- Job worker (contract C8; docs/DEPLOY.md) ----
# Health/metrics listener of `node dist/worker.js` (GET /health, GET /metrics)
WORKER_HEALTH_PORT=9465
# On stop: heavy jobs checkpoint at once, critical jobs get this long; the orchestrator's grace period must be >= this + 60 s
WORKER_DRAIN_TIMEOUT_MS=120000
# ---- Observability ----
# Bearer token (>= 16 chars) for scraping /metrics; metrics listener port
METRICS_TOKEN=
METRICS_PORT=9464
# OTLP/HTTP collector endpoint (tracing off when empty) and service name
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=kkt-api
# Slack-compatible webhook for unhandled errors and failed jobs (off when empty)
ERROR_WEBHOOK_URL=
# ---- Deployment (docker-compose.prod.yml; docs/DEPLOY.md) ----
# Immutable image tag to run (the git SHA CI pushed, or a release tag) — required by docker-compose.prod.yml; never "latest"
IMAGE_TAG=
# Registry prefix of the images (default "kkt" = built on this host with --build), e.g. ghcr.io/<owner>/kkt
KKT_IMAGE_PREFIX=kkt
WORKER_REPLICAS=2
# Quick start (docker-compose.yml, no PgBouncer) only: each worker's database pool, so API + workers stay under max_connections
WORKER_DATABASE_POOL_MAX=8
# The company slug the website serves on a multi-company API (contract C4); empty = the API's only company
KKT_COMPANY_SLUG=
# ---- Frontends ----
VITE_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PORTAL_URL=http://localhost:8081
NEXT_PUBLIC_ERP_URL=http://localhost:5173
EXPO_PUBLIC_API_URL=http://localhost:4000
