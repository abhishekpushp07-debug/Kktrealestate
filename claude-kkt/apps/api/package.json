{
  "name": "@kkt/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "seed": "tsx src/seed/run.ts",
    "test": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration --no-file-parallelism",
    "test:acceptance": "vitest run --dir test/acceptance --no-file-parallelism",
    "test:all": "vitest run --no-file-parallelism",
    "loadtest": "tsx loadtest/run.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.1.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/etag": "^6.0.3",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/static": "^8.2.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/under-pressure": "^9.0.3",
    "@kkt/contracts": "workspace:*",
    "@kkt/db": "workspace:*",
    "@kkt/domain": "workspace:*",
    "argon2": "^0.44.0",
    "bullmq": "^5.56.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^5.0.0",
    "file-type": "^21.0.0",
    "ics": "^3.8.1",
    "ioredis": "^5.6.1",
    "jose": "^6.0.11",
    "luxon": "^3.6.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.17.1",
    "pino": "^9.7.0",
    "postgres": "^3.4.7",
    "sharp": "^0.34.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.6.2",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.14.0",
    "autocannon": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  }
}
