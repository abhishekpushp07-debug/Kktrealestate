# Browser-facing API origin (inlined at build time for client bundles; also read at runtime on the server)
NEXT_PUBLIC_API_URL=http://localhost:4000
# In-cluster API origin used by the Next.js server for data fetching (falls back to NEXT_PUBLIC_API_URL)
API_INTERNAL_URL=http://localhost:4000
# Customer portal ("Customer Login" link)
NEXT_PUBLIC_PORTAL_URL=http://localhost:8081
# Staff ERP ("Staff login" link in the footer)
NEXT_PUBLIC_ERP_URL=http://localhost:5173
# Canonical public origin of this website (metadataBase, canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
