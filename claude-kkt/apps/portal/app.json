{
  "expo": {
    "name": "KKT",
    "slug": "kkt-portal",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kkt",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0B1F3A",
    "primaryColor": "#0B1F3A",
    "ios": {
      "bundleIdentifier": "com.kkt.portal",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "KKT uses the camera so you can attach photos to a service request.",
        "NSPhotoLibraryUsageDescription": "KKT needs photo access so you can attach pictures to a service request.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kkt.portal",
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA", "android.permission.READ_MEDIA_IMAGES"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "KKT — My Home",
      "shortName": "KKT",
      "themeColor": "#0B1F3A",
      "backgroundColor": "#F8F6F1",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1F3A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KKT needs photo access so you can attach pictures to a service request.",
          "cameraPermission": "KKT uses the camera so you can attach photos to a service request."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "eas": {}
    }
  }
}
