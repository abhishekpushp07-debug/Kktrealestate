    def test_corrupt_image_does_not_stop_variant_batch(admin_headers):
        """Two good PNGs + one PNG-signature file with garbage body: good ones get 3 WebP variants, bad one is 'failed', job run records the error."""
        ids = []
        for name, data in (
            ("a.png", _png()),
            ("bad.png", b"\x89PNG\r\n\x1a\n" + os.urandom(4000)),
            ("b.png", _png(300, 200)),
        ):
            up = _upload(
                admin_headers,
                name,
                data,
                kind="construction_photo",
                entity_type="milestone",
                entity_id="t-ms",
                project_id="t-proj",
            )
            r = requests.post(f"{BASE}/api/uploads/{up['id']}/complete", headers=admin_headers)
            assert r.status_code == 201, r.text
            ids.append(r.json()["id"])
        deadline = time.time() + 60
        states = {}
        while time.time() < deadline:
            rows = requests.get(
                f"{BASE}/api/files", params={"entity_type": "milestone", "entity_id": "t-ms"}, headers=admin_headers
            ).json()["items"]
            states = {x["id"]: x for x in rows if x["id"] in ids}
            if all(states[i]["variants_state"] in ("ready", "failed") for i in ids if i in states) and len(states) == 3:
                break
            time.sleep(1)
        assert (
            states[ids[0]]["variants_state"] == "ready"
            and states[ids[2]]["variants_state"] == "ready"
            and states[ids[1]]["variants_state"] == "failed"
        )
        v = states[ids[2]]["variants"]
        assert set(v) == {"thumb", "medium", "large"} and all(
            u.startswith("/api/files/variants/") and u.endswith(".webp") for u in v.values()
        )
        img = requests.get(f"{BASE}{v['thumb']}")
