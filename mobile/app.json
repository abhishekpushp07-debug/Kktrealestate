{
  "expo": {
    "name": "KKT Home",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.royalrealtyhub.dhbi8q",
      "infoPlist": {
        "NSCameraUsageDescription": "Photograph site issues for your service requests",
        "NSPhotoLibraryUsageDescription": "Attach photos to your service requests"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B1F3A"
      },
      "package": "com.emergent.royalrealtyhub.dhbi8q",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F6F1"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos to your service requests",
          "cameraPermission": "Photograph site issues for your service requests"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/portal"
    }
  }
}